; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ld60"
run/main_scene="uid://ck08mlqov6xn1"
config/features=PackedStringArray("4.7")
config/icon="res://icon.png"

[aseprite]

import/import_plugin/default_automatic_importer="Static Texture"
import/import_plugin/generate_bake_files=true

[autoload]

DebugOverlayDisplay="*res://util/debug_overlay/debug_overlay_display.tscn"
InWorldDebugDisplay="*res://util/debug_overlay/in_world_overlay.tscn"
DebugOverlay="*res://util/debug_overlay/debug_overlay.gd"
AudioSettings="*res://util/audio/audio_settings.gd"
GlobalSounds="*res://util/audio/global_sounds.tscn"
UiSoundConnector="*uid://c5pshemmbfsxc"
CameraEffects="*uid://cvbgini30ani7"
PixelPerfect="*uid://cj1t54yqd0yjn"
PauseMenu="*res://util/pause_menu/pause_menu.tscn"
TransitionLayer="*res://util/transition/transition_layer.tscn"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/AsepriteWizard/plugin.cfg")

[gui]

theme/custom="uid://cejyvtyo48vcw"

